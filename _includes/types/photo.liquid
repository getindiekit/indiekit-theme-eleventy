<article class="h-entry">
  {%- if date %}<time class="dt-published" datetime="{{ date | isoInstant }}">{{ date | date: "%-d %B %Y" }}</time>{% endif %}
  {%- for image in photo %}
  <img class="u-photo" src="{{ image.url }}" alt="{{ image.alt | default: '' }}" eleventy:optional="keep">
  {%- endfor %}
  <div class="e-content">{{ content }}</div>
</article>
