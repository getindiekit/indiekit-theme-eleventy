<article class="h-entry">
  {%- if title %}<h1 class="p-name"><a class="u-url" href="{{ page.url }}">{{ title }}</a></h1>{% endif %}
  {%- if date %}<time class="dt-published" datetime="{{ date | isoInstant }}">{{ date | humanDate }}</time>{% endif %}
  {%- comment %} Task 18 (§7.4): source (page.liquid:9-11, post.liquid:55-57)
  wraps the content div's body in <heading-anchors selector="h2,h3">. h2/h3 is
  the source's own choice (its h1 is reserved for the page/post title above,
  matching this partial's own <h1 class="p-name"> — content headings start at
  h2). IdAttributePlugin (eleventy.config.js) already stamps every heading
  with an id server-side; heading-anchors adds the visible anchor link as a
  progressive enhancement on top, so the ids work with JS disabled. {% endcomment -%}
  <div class="e-content"><heading-anchors selector="h2,h3">{{ content }}</heading-anchors></div>
</article>
