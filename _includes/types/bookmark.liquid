<article class="h-entry">
  {%- if date %}<time class="dt-published" datetime="{{ date | date: '%Y-%m-%dT%H:%M:%SZ' }}">{{ date | date: "%-d %B %Y" }}</time>{% endif %}
  {%- if bookmarkOf %}<a class="u-bookmark-of" href="{{ bookmarkOf }}">{{ title | default: bookmarkOf }}</a>{% endif %}
  <div class="e-content">{{ content }}</div>
</article>
