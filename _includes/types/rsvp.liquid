{%- comment %} Shaped like reply.liquid. `rsvp` is yes, no, maybe or interested. {% endcomment -%}
{%- case rsvp -%}
	{%- when "yes" %}{% assign rsvpText = "Going" %}
	{%- when "no" %}{% assign rsvpText = "Not going" %}
	{%- when "maybe" %}{% assign rsvpText = "Might go" %}
	{%- when "interested" %}{% assign rsvpText = "Interested" %}
	{%- else %}{% assign rsvpText = "RSVP" %}
{%- endcase -%}
{%- if lcp -%}
<a class="u-url sr-only" href="{{ page.url }}">{{ title }}</a>
{%- if date %}<time class="dt-published" datetime="{{ date | isoInstant }}">{{ date | humanDate }}</time>{% endif %}
{%- if inReplyTo %}<p><data class="p-rsvp" value="{{ rsvp }}">{{ rsvpText }}</data> to</p>{% include "partials/link-preview.liquid", linkTarget: inReplyTo, linkClass: "u-in-reply-to" %}{% endif %}
<div class="content-grid e-content"><heading-anchors selector="h2,h3">{{ content }}</heading-anchors></div>
{%- else -%}
<a class="posts-link u-url" href="{{ page.url }}">RSVP: {{ rsvpText }}{% if inReplyTo %} to {{ inReplyTo.url | default: inReplyTo }}{% endif %}</a>
{{ socialHtml }}
{%- if date %}<time class="date dt-published" datetime="{{ date | isoInstant }}">{{ date | listingDate }}</time>{% endif %}
{%- endif -%}
