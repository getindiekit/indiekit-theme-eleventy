{%- if lcp -%}
<a class="u-url" href="{{ page.url }}">{{ title }}</a>
{%- if date %}<time class="dt-published" datetime="{{ date | isoInstant }}">{{ date | humanDate }}</time>{% endif %}
{%- if likeOf %}<p>Liked <a class="u-like-of" href="{{ likeOf }}">{{ likeOf }}</a></p>{% endif %}
{%- else -%}
{%- comment %} Task S4 (audit §2.2, corrected — see task-s4-report.md): a
like is titleless by IndieWeb design and has no text of its own (see
types/note.liquid for the same "<Type> · <date>" fallback / .sr-only
reasoning) — its substance is the thing being liked, so that's what's shown.
{% endcomment -%}
<a class="p-name u-url sr-only" href="{{ page.url }}">{{ title }}</a>
{%- if date %}<time class="date dt-published" datetime="{{ date | isoInstant }}">{{ date | humanDate }}</time>{% endif %}
<span class="tags"></span>
{%- if likeOf %}<p class="description">Liked <a class="u-like-of" href="{{ likeOf }}">{{ likeOf }}</a></p>{% endif %}
{%- endif -%}
