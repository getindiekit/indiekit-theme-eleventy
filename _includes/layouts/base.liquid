{%- capture fullUrl %}{{ site.url }}{{ page.url }}{% endcapture -%}
<!doctype html>
<html lang="en"{% if tmpl or templateclass or classes.html %} class="{% if tmpl %}tmpl-{{ tmpl }}{% endif %}{% if templateclass %} {{ templateclass }}{% endif %}{%- if classes.html %} {{ classes.html }}{% endif -%}"{% endif %}{% if eleventy.env.runMode == "serve" %} data-eleventy-runmode="{{ eleventy.env.runMode }}"{% endif %}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>{% if title %}{% if titleOverride %}{{ titleOverride }}{% else %}{{ title }}{% endif %}—{{ site.name }}{% else %}{{ site.name }}{% endif %}</title>

		<link rel="preload" href="/static/fonts/lato/2.0/latolatin-regular-subset.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/static/fonts/hex-franklin/HEX_Franklin_v0.2_Tyght_Variable-subset.woff2" as="font" type="font/woff2" crossorigin>

		<meta name="author" content="{{ site.author.name }}">
		<meta name="description" content="{% if description %}{{ description }}, {% endif %}{% if title %}A post by {% endif %}{{ site.author.name }}">
		<meta name="generator" content="{{ eleventy.generator }}">

{%- if noindex %}
		{% comment %}For OpenGraph image pages{% endcomment %}
		<meta name="robots" content="noindex">
{%- endif %}

		{% comment %} TODO(Task 11): favicon assets are a README/asset concern — restore once the icon files exist in this theme.
		<!-- Icons -->
		<link rel="apple-touch-icon-precomposed" href="{% getUrlForImage site.avatarImgSrc, 192, 'png' %}">
		<link rel="icon" href="{% getUrlForImage site.avatarImgSrc, 192, 'jpeg' %}" sizes="192x192" type="image/jpeg">
		{% endcomment %}

		<!-- Social -->
		<meta property="og:title" content="{% if title %}{{ title }}—{{ site.name }}{% else %}{{ site.name }}{% endif %}">
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="{{ site.name }}">
		<meta property="og:description" content="{% if description %}{{ description }}, {% endif %}{% if title %}A post by {% endif %}{{ site.author.name }}">
		{% comment %} Known unimplemented feature, not a pending task: og:image depends on an
		`ogImageSource`/`getOpenGraphImageUrl` shortcode that no task in this plan has wired up.
		<meta property="og:image" content="{% ogImageSource page %}">
		{% endcomment %}
		<meta property="og:url" content="{{ site.url }}{{ page.url }}">

		<!-- SEO/Feeds -->
		<link rel="canonical" href="{{ fullUrl }}">
{% if rssFeedUrl and rssFeedTitle %}
		<link rel="alternate" href="{{ rssFeedUrl }}" title="{{ rssFeedTitle }}" type="application/atom+xml">
{% else %}
		<link rel="alternate" href="/feed.xml" title="{{ site.name }} Posts Feed" type="application/atom+xml">
		<link rel="alternate" href="/follow/" title="{{ site.name }} Activity Feed" type="application/rss+xml">
{% endif %}

		<link rel="stylesheet" href="/_css/index.css">
		{% comment %} TODO(unresolved shortcode): the source also used `{% renderFile "./static/initial.scss" %}` (inline-compiled critical CSS) here for the "build" runMode branch — not registered by this theme's eleventy.config.js. See task-4-report.md. {% endcomment %}
		{% comment %} Known gap, not a pending task: the WebC plugin is registered
		(eleventy.config.js) but this `{% getBundle 'css' %}` call is left unwired —
		it would output CSS that .webc components bundle via <style>. Concretely,
		toggle-button.webc's own <style> block bundles into 'css' and, unwired, is
		silently dropped: those rules vanish the moment anyone uses the component.
		<style>{% getBundle 'css' %}</style><!-- WebC -->
		{% endcomment %}

		<!-- Preconnect to Eleventy services -->
		<link href="https://v1.opengraph.11ty.dev" rel="preconnect" crossorigin>
		<link href="https://v1.indieweb-avatar.11ty.dev" rel="preconnect" crossorigin>

{% comment %} The source split CSS into critical (`initial.css`) and deferred
(`defer.css`) bundles, and looped over `stylesheets`/`stylesheetsDist` collections
it populated elsewhere. This theme compiles one stylesheet, linked above, and
populates neither collection — so those links pointed at paths that are never
built. Restore a split here only alongside something that produces both files. {% endcomment %}

{%- if JS_ENABLED %}
		{% comment %} TODO(unresolved shortcode): the source also gated a goatcounter analytics `<script>` on runMode == "build" here — analytics dropped per scope. {% endcomment %}
		{% comment %} Known gap, not a pending task: same as the CSS bundle above —
		the WebC plugin is registered but this `{% getBundle 'js' %}` call is left
		unwired, so any .webc component's bundled <script> is silently dropped.
		<script type="module">{% getBundle 'js' %}</script><!-- WebC -->
		{% endcomment %}
		<script src="/static/defer.js" type="module"></script>
{%- endif %}

		<meta property="eleventy:path" content="{{ page.inputPath }}">

		<!-- IndieAuth -->
{% if site.author.url %}
		<link href="{{ site.author.url }}" rel="me">
{% endif %}
		{% comment %} TODO(Task 7): webmention/pingback discovery links restored when the webmention endpoint is ported. {% endcomment %}
	</head>
	<body class="{%- if classes and classes.body %} {{ classes.body }}{% endif -%}"
		{% unless excludeFromSearch %} data-pagefind-body{% endunless %}>
		{{ content }}
{%- if site.speedlify.enabled %}
{%- capture urlWithOrigin %}{{ site.url }}{{ page.url }}{% endcapture -%}
		<script type="module" src="/js/speedlify2-score.js"></script>
		<speedlify2-score theme="light" speedlify-url="{{ site.speedlify.url }}" url="{{ urlWithOrigin }}"></speedlify2-score>
{%- endif %}
{%- if JS_ENABLED %}
{%- for url in scripts -%}
		<script src="{{ url }}" defer></script>
{%- endfor %}
{%- for url in modules -%}
		<script src="{{ url }}" type="module"></script>
{%- endfor %}
{%- endif %}
	</body>
</html>