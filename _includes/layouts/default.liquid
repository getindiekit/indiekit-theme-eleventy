---
layout: layouts/base.liquid
classes:
  html: page-gradient
  body: body-grid
modules:
  # Task 18 (§7.4): source (zachleat.com default.liquid:6-8) declares these
  # as "/static/heading-anchors.js" and "/static/js/time-difference.js" —
  # this theme's {static: "/"} passthrough mapping (eleventy.config.js)
  # strips the "static/" prefix from every vendored asset it copies (see
  # speedlify2-score.js, served at /js/... not /static/js/...), so the
  # equivalent real paths here drop that prefix too. Neither file existed
  # under either path before this task — see eleventy.config.js and
  # static/js/time-difference.js for how each is now built.
  - "/heading-anchors.js"
  - "/js/time-difference.js"
---
<a href="#skiplink-content" id="skiplink-top" class="skiplink skiplink-fn" data-pagefind-ignore>Skip to Content</a>
<div class="rail" data-pagefind-ignore>
	<div class="rail-sticky">
		<header>
			<a href="/" class="header">
				<span class="hed-h1">{{ site.name }}</span>
			</a>
		</header>
		<aside>
			<nav role="navigation">
				<div class="navigation">
					<button type="button" class="navigation-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
					<ul class="list-flush tags-rail-links" id="site-nav">
						{% comment %} Only destinations this theme actually builds. The source's
						page list (/uses/, /domains/, /projects/, /web/speaking/) was hardcoded
						chrome for that site and 404'd here. Indiekit sites create their own pages
						through the page post type at runtime, so the theme must not invent a
						structure a first-time user would only delete. {% endcomment %}
						<li><a href="/" {% if page.url == '/' %}class="active"{% endif %}>Home</a></li>
						<li><a href="/search/" {% if page.url == '/search/' %}class="active"{% endif %}>Search</a></li>
					</ul>
				</div>
			</nav>
			<script type="module">
				const toggle = document.querySelector(".navigation-toggle");
				const nav = document.querySelector("#site-nav");
				if (toggle && nav) {
					toggle.addEventListener("click", () => {
						const open = toggle.getAttribute("aria-expanded") === "true";
						toggle.setAttribute("aria-expanded", String(!open));
					});
				}
			</script>
		</aside>
	</div>
</div>
<main class="content-main" data-role="main" id="skiplink-content">
	{{ content }}
</main><!-- /.content -->

{% comment %} TODO(Task 10): WebC bundle registration lands in Task 10. The
source loaded its font-awesome icon sprite here, alongside the css/js bundles
preserved in base.liquid.
{% getBundle "fontawesome" %}
{% endcomment %}

<div class="hamburger">
	<is-land on:idle on:visible on:media="(prefers-reduced-motion: no-preference) and (min-width: 61.1875em)">
		<infinity-burger theme-fn></infinity-burger>

		<template data-island="once">
			<style>
			/* Desktop only, for extra laughs */
			@media (max-width: 61.1875em) { /* 979px */
				infinity-burger {
					display: none;
				}
			}
			</style>
{%- if JS_ENABLED %}
			<script>
			function InfinityBurgerColor(count) {
				return `hsl(${count * 5 % 360}, 100%, 50%)`
			}
			</script>
			<script type="module" src="/static/infinity-burger.js"></script>
{%- endif %}
		</template>
	</is-land>
</div>
