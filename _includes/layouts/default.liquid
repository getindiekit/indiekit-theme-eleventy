---
layout: layouts/base.liquid
classes:
  html: page-gradient
  body: body-grid
modules:
  - "/static/heading-anchors.js"
  - "/static/js/time-difference.js"
---
<a href="#skiplink-content" id="skiplink-top" class="skiplink skiplink-fn" data-pagefind-ignore>Skip to Content</a>
<div class="rail" data-pagefind-ignore>
	<div class="rail-sticky">
		<header>
			<a href="/" class="header">
				<span class="hed-h1">{{ site.name }}</span>
			</a>
		</header>
		<aside>
			<nav role="navigation">
				<div class="navigation">
					<ul class="list-flush tags-rail-links">
						<li><a href="/" {% if page.url == '/' %}class="active"{% endif %}>Home</a></li>
						<li><a href="/about/" {% if page.url == '/about/' %}class="active"{% endif %}>About</a></li>
						<li><a href="/web/" {% if page.url == '/web/' %}class="active"{% endif %}>Archives</a></li>
						<li><a href="/projects/" {% if page.url == '/projects/' %}class="active"{% endif %}>Projects</a></li>
						<li><a href="/web/speaking/" {% if page.url == '/web/speaking/' %}class="active"{% endif %}>Speaking</a></li>
						<li class="hide-singlecol"><a href="/uses/" {% if page.url == '/uses/' %}class="active"{% endif %}>Uses</a></li>
						<li class="hide-singlecol"><a href="/domains/" {% if page.url == '/domains/' %}class="active"{% endif %}>Domains</a></li>
					</ul>
				</div>
			</nav>
		</aside>
	</div>
</div>
<main class="content-main" data-role="main" id="skiplink-content">
	{{ content }}
</main><!-- /.content -->

{% comment %} TODO(Task 10): WebC bundle registration lands in Task 10. The
source loaded its font-awesome icon sprite here, alongside the css/js bundles
preserved in base.liquid.
{% getBundle "fontawesome" %}
{% endcomment %}

<div class="hamburger">
	<is-land on:idle on:visible on:media="(prefers-reduced-motion: no-preference) and (min-width: 61.1875em)">
		<infinity-burger theme-fn></infinity-burger>

		<template data-island="once">
			<style>
			/* Desktop only, for extra laughs */
			@media (max-width: 61.1875em) { /* 979px */
				infinity-burger {
					display: none;
				}
			}
			</style>
{%- if JS_ENABLED %}
			<script>
			function InfinityBurgerColor(count) {
				return `hsl(${count * 5 % 360}, 100%, 50%)`
			}
			</script>
			<script type="module" src="/static/infinity-burger.js"></script>
{%- endif %}
		</template>
	</is-land>
</div>
