---
layout: layouts/base.liquid
classes:
  body: body-grid
modules:
  # Task 18 (§7.4): source (zachleat.com default.liquid:6-8) declares these
  # as "/static/heading-anchors.js" and "/static/js/time-difference.js" —
  # this theme's {static: "/"} passthrough mapping (eleventy.config.js)
  # strips the "static/" prefix from every vendored asset it copies (see
  # speedlify2-score.js, served at /js/... not /static/js/...), so the
  # equivalent real paths here drop that prefix too. Neither file existed
  # under either path before this task — see eleventy.config.js and
  # static/js/time-difference.js for how each is now built.
  - "/heading-anchors.js"
  - "/js/time-difference.js"
---
<a href="#skiplink-content" id="skiplink-top" class="skiplink skiplink-fn" data-pagefind-ignore>Skip to Content</a>
<div class="rail" data-pagefind-ignore>
	<div class="rail-sticky">
		<header>
			<a href="/" class="header">
				<span class="hed-h1">{{ site.name }}</span>
			</a>
{%- if site.theme.schemeToggle %}
			{%- comment %} Server-rendered state matches the configured default so
			   there is no flash of a wrong label/pressed-state before the client
			   script (below) corrects it. `auto` has no dark default to reflect
			   here — it renders as light, same as before, and the script resolves
			   it against the OS at load. {% endcomment -%}
			{%- assign toggleDark = false -%}
			{%- if site.theme.scheme == "dark" -%}{%- assign toggleDark = true -%}{%- endif -%}
			<button type="button" class="scheme-toggle" aria-pressed="{{ toggleDark }}" aria-label="{% if toggleDark %}Switch to light scheme{% else %}Switch to dark scheme{% endif %}">
				{%- comment %} One half-filled circle for both states: the contrast symbol.
				   A sun/moon pair was tried; Font Awesome's sun reads as a cog at icon
				   size. The button's label says which way it switches. {% endcomment -%}
				<span class="scheme-toggle-icon" aria-hidden="true">{% icon "fas:circle-half-stroke" %}</span>
			</button>
{%- endif %}
		</header>
		<aside>
			<nav role="navigation">
				<div class="navigation">
					<button type="button" class="navigation-toggle" aria-expanded="false" aria-controls="site-nav"><span class="navigation-toggle-icon" aria-hidden="true"></span><span class="sr-only">Menu</span></button>
					<ul class="list-flush tags-rail-links" id="site-nav">
						{% comment %} Only destinations this theme actually builds. The source's
						page list (/uses/, /domains/, /projects/, /web/speaking/) was hardcoded
						chrome for that site and 404'd here. Indiekit sites create their own pages
						through the page post type at runtime, so the theme must not invent a
						structure a first-time user would only delete. {% endcomment %}
						<li><a href="/" {% if page.url == '/' %}class="active"{% endif %}>Home</a></li>
						{%- comment %} Pages the operator chose, in the order listed in
						site.json's `navigation` — see _data/navigation.js. Nothing is listed
						by default; a page exists whether or not it is in the menu. {% endcomment -%}
						{%- for item in navigation %}
						<li><a href="{{ item.url }}" {% if page.url == item.url %}class="active"{% endif %}>{{ item.title }}</a></li>
						{%- endfor %}
						<li><a href="/collections/" {% if page.url == '/collections/' %}class="active"{% endif %}>Collections</a></li>
						<li><a href="/search/" {% if page.url == '/search/' %}class="active"{% endif %}>Search</a></li>
					</ul>
				</div>
			</nav>
			<script type="module">
				const toggle = document.querySelector(".navigation-toggle");
				const nav = document.querySelector("#site-nav");
				if (toggle && nav) {
					toggle.addEventListener("click", () => {
						const open = toggle.getAttribute("aria-expanded") === "true";
						toggle.setAttribute("aria-expanded", String(!open));
					});
				}
			</script>
{%- if site.theme.schemeToggle %}
			<script type="module">
				const html = document.documentElement;
				const button = document.querySelector(".scheme-toggle");
				const osDark = matchMedia("(prefers-color-scheme: dark)");
				const resolve = (scheme) => (scheme === "auto" ? (osDark.matches ? "dark" : "light") : scheme);
				const render = () => {
					const dark = resolve(html.dataset.scheme) === "dark";
					button.setAttribute("aria-pressed", String(dark));
					button.setAttribute("aria-label", dark ? "Switch to light scheme" : "Switch to dark scheme");
				};
				button.addEventListener("click", () => {
					const next = resolve(html.dataset.scheme) === "dark" ? "light" : "dark";
					// Choosing what the site would show anyway is not an override: drop the
					// stored value and return to the configured default, so "follow the OS"
					// stays reachable without a third state.
					if (next === resolve(html.dataset.schemeDefault)) {
						try { localStorage.removeItem("scheme"); } catch (e) {}
						html.dataset.scheme = html.dataset.schemeDefault;
					} else {
						try { localStorage.setItem("scheme", next); } catch (e) {}
						html.dataset.scheme = next;
					}
					render();
				});
				osDark.addEventListener("change", render);
				render();
			</script>
{%- endif %}
		</aside>
{%- comment %} The site's representative h-card lives in the rail, not on the
   homepage: it is site chrome, so rel=author (footer) resolves to an h-card
   from EVERY page rather than only the front one. Renders nothing until
   site.json names an author. On single-column widths .rail-sticky is a flex
   row carrying the title and the menu toggle, so the card is given a
   full-width basis there and wraps onto its own line. {% endcomment -%}
		{% include "partials/h-card.liquid" %}
	</div>
</div>
<main class="content-main" data-role="main" id="skiplink-content">
	{{ content }}
	{% include "footer.html" %}
</main><!-- /.content -->

{% comment %} The Font Awesome sprite, in the same place the source puts it
(layouts/default.liquid:75): after <main>, so every {% raw %}{% icon %}{% endraw %} rendered
anywhere above has already registered its symbol in the bundle by the time this
outputs. This call was commented out behind a "TODO(Task 10)" until the listing
rows started using icons — the shortcode was registered and the sprite was never
emitted, so an {% raw %}{% icon %}{% endraw %} rendered a <use href="#..."> pointing at a symbol
that did not exist and painted nothing at all. {% endcomment %}
{% getBundle "fontawesome" %}

{%- comment %} The port source has an <infinity-burger> easter egg here — a
   decorative animated hamburger. It is removed rather than ported: the
   custom element's JS (/static/infinity-burger.js) does not exist in the
   source checkout either, so it 404s there too. Shipping a guaranteed
   console error on every page of a theme other people deploy, for a
   decoration that has never worked, is not a faithful port of anything.
   {% endcomment -%}
